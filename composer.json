{
  "name": "mehran-mrn/mrn-wp-form",
  "description": "Lightweight professional form builder for WordPress with entries and email notifications.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.2"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": "phpcs",
    "test": [
      "@php tests/test-i18n.php",
      "@php tests/test-validator.php",
      "@php tests/test-field-registry.php",
      "@php tests/test-form-repository.php",
      "@php tests/test-email-notifications.php"
    ]
  }
}
